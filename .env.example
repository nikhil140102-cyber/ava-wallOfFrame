# Copy to .env.local (npm run setup does this for you)
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-characters
DATABASE_URL=file:./data/app.db
# For a hosted libSQL/Turso database instead of a local file:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
# Local demo only — never set this on a real company's site.
SHOW_DEMO_ACCOUNTS=true
# Live deployments: skip the demo company entirely
# SEED_DEMO_DATA=false
# Post photos are stored in the database, so no upload folder is needed.
# On Vercel the Turso integration's TURSO_DATABASE_URL / TURSO_AUTH_TOKEN also work.
